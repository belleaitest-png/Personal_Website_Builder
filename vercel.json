{
  "buildCommand": "echo 'Serving holding page while the site is rebuilt'",
  "outputDirectory": "rebuilding",
  "functions": {
    "api/send-email.js": {
      "includeFiles": "api/birth-rates-paper.pdf"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
